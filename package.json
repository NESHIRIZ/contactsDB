{
  "name": "contacts-api",
  "version": "1.0.0",
  "description": "Contacts CRUD API for BYU-Idaho W03 Project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seedContacts.js",
    "test": "jest --detectOpenHandles --forceExit --passWithNoTests"
  },
  "keywords": [
    "contacts",
    "api",
    "mongodb",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^7.5.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "modulePathIgnorePatterns": ["<rootDir>/mongodb-test/", "<rootDir>/contactDBs/mongodb-test/"],
    "testPathIgnorePatterns": ["<rootDir>/mongodb-test/", "<rootDir>/contactDBs/mongodb-test/"],
    "collectCoverageFrom": ["controllers/**/*.js", "routes/**/*.js"],
    "coveragePathIgnorePatterns": ["/node_modules/"]
  }
}
